# ============================================================
# BLACK BOX ARCHIVE · 站点 Nginx 配置模板
# 占位符 __DOMAIN__ 由 deploy/scripts/set-domain.sh 自动替换
# 渲染后部署到：/etc/nginx/conf.d/portfolio.conf
# 适用：Ubuntu/Debian/CentOS 上的 Nginx 1.18+
# ============================================================

# ---------- 80 端口：只做 ACME 校验 + 全量跳转 ----------
server {
    listen      80;
    listen      [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    # Certbot webroot 校验目录，签发与续期都依赖它，禁止删除
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # 除校验路径外，一律 301 到 HTTPS 主域名
    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

# ---------- 443：www 归一化到主域名 ----------
server {
    # HTTP/2 写法兼顾 Nginx 1.18–1.24（Ubuntu 22.04 自带 1.18 必须用此写法）
    # 若你的 Nginx ≥ 1.25.1，可改为 "listen 443 ssl;" 并单独加一行 "http2 on;"
    listen      443 ssl http2;
    listen      [::]:443 ssl http2;
    server_name www.__DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    return 301 https://__DOMAIN__$request_uri;
}

# ---------- 443：主站 ----------
server {
    # HTTP/2 写法兼顾 Nginx 1.18–1.24（Ubuntu 22.04 自带 1.18 必须用此写法）
    # 若你的 Nginx ≥ 1.25.1，可改为 "listen 443 ssl;" 并单独加一行 "http2 on;"
    listen      443 ssl http2;
    listen      [::]:443 ssl http2;
    server_name __DOMAIN__;

    root  /var/www/portfolio;
    index index.html;
    charset utf-8;
    charset_types text/css application/javascript application/json image/svg+xml;
    server_tokens off;

    # ===== TLS =====
    ssl_certificate         /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/__DOMAIN__/chain.pem;
    ssl_protocols           TLSv1.2 TLSv1.3;
    ssl_ciphers             ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache       shared:SSL:10m;
    ssl_session_timeout     1d;
    ssl_session_tickets     off;
    # OCSP stapling（Let's Encrypt 已停发 OCSP，此项保留无副作用，可按需删除）
    ssl_stapling            on;
    ssl_stapling_verify     on;
    resolver                223.5.5.5 119.29.29.29 valid=300s;
    resolver_timeout        5s;

    # ===== 性能 =====
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;

    gzip            on;
    gzip_vary       on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json image/svg+xml application/xml;
    gzip_disable    "msie6";

    # ===== 安全响应头（只在 server 层写；不要在 location 里再写 add_header，
    #       否则该 location 会丢弃这些继承来的头）=====
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;

    # HSTS 进阶：确认所有子域都已启用 HTTPS 后，再追加 ; includeSubDomains
    # 一旦下发即无法撤销（浏览器会记住 max-age 时长），务必先验证再改。

    # CSP 可选：本站为纯静态、无第三方脚本，可按需启用。
    # 启用前请用浏览器控制台确认无 inline script 被拦截。
    # add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" always;

    # ===== 缓存策略（用 expires 而非 add_header，避免破坏上面的头继承）=====
    # HTML 不缓存，保证改版立刻生效
    location = /index.html {
        expires -1;
    }

    # 样式与脚本：7 天
    location ~* \.(?:css|js)$ {
        expires 7d;
        try_files $uri =404;
    }

    # 图片与封面：30 天
    location ~* \.(?:jpg|jpeg|png|webp|avif|svg|ico)$ {
        expires 30d;
        try_files $uri =404;
    }

    # 视频：30 天。nginx 对静态文件默认支持 Range 请求（206），
    # 拖动进度条依赖它，故此处不做任何 rewrite。
    location ~* \.(?:mp4|webm|m4v)$ {
        expires 30d;
        try_files $uri =404;
        # 如需服务端伪流（快速起播），且 nginx 编译了 ngx_http_mp4_module，可放开下一行：
        # mp4;
    }

    # 简历 PDF：1 小时（更新频繁且体积小）
    location ~* \.pdf$ {
        expires 1h;
        try_files $uri =404;
    }

    # ===== 兜底 =====
    location / {
        try_files $uri $uri/ =404;
    }

    # 禁止访问隐藏文件（放行 ACME 校验路径）
    location ~ /\.(?!well-known) {
        deny all;
    }

    # 404 保持 nginx 默认页，避免静态资源缺失时也被 HTML 兜底掩盖
}
